{
  "name": "@partybox/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/src/main.js\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "migrate": "npm run build && node dist/src/rooms/migrate-main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@partybox/game-contracts": "0.1.0",
    "ajv": "8.20.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4",
    "tsc-watch": "7.2.1"
  }
}
